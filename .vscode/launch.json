{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Dev (nodemon + tsx)",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeExecutable": "nodemon",
            "runtimeArgs": [
                "--watch",
                "src",
                "--watch",
                "index.ts",
                "--ext",
                "ts,js,json",
                "--exec",
                "tsx"
            ],
            "program": "${workspaceFolder}/index.ts",
            "args": [
                "videogame",
                "audio8.mp3"
            ],
            "console": "integratedTerminal"
        }
    ]
}